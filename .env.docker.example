# ==============================================================================
# Environment Configuration
# ==============================================================================
NODE_ENV=production

# ==============================================================================
# Database Configuration (PostgreSQL container)
# ==============================================================================
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_strong_postgres_password
POSTGRES_DB=your_database_name
DATABASE_URL=postgresql://your_postgres_user:your_strong_postgres_password@db:5432/your_database_name?schema=public

# ==============================================================================
# Ports & Hostnames
# ==============================================================================
BACKEND_PORT=4000
BACKEND_HOST_PORT=4000
FRONTEND_PORT=3000
FRONTEND_HOST_PORT=3001
FRONTEND_HOSTNAME=0.0.0.0

# ==============================================================================
# Authentication & Security Secrets
# ==============================================================================
# Minimum 32-character random string
JWT_SECRET=your_private_random_secret_at_least_32_characters
JWT_EXPIRES_IN_MINUTES=480

# ==============================================================================
# Client & API Origins
# ==============================================================================
# Publicly accessible URL for frontend and API
WEB_ORIGIN=https://crm.durozen.in
NEXT_PUBLIC_API_URL=/api