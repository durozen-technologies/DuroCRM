# Environment Configuration
NODE_ENV=development

# Database Configuration (Local PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_DB=durozen_crm
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/durozen_crm?schema=public

# Ports
PORT=4000
BACKEND_PORT=4000
FRONTEND_PORT=3000

# Authentication & Security Secrets (minimum 32 characters)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN_MINUTES=480

# Application URLs & Origins
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

